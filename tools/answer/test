#!/usr/bin/env bash
# Runs `answer` against a fake `claude` that gives the verdicts the cases
# set, so the rules kept out of the models are checked without a call.
#   tools/answer/test
set -euo pipefail

here=$(dirname "$(realpath "$0")")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The fake answers as the judge, the responder or the reviewer, told apart
# by the schema it is given, with $FAKE_JUDGE, $FAKE_RESPOND or $FAKE_REVIEW,
# and fails when that one is unset. It writes each call to $FAKE_CALLS.
cat >"$tmp/claude" <<'EOF'
#!/usr/bin/env bash
schema=
while [[ $# -gt 0 ]]; do
  if [[ $1 == --json-schema ]]; then schema=$2; shift; fi
  shift
done
cat >/dev/null
case $schema in
  *category*) role=judge answer=${FAKE_JUDGE-} ;;
  *verdict*) role=review answer=${FAKE_REVIEW-} ;;
  *) role=respond answer=${FAKE_RESPOND-} ;;
esac
printf '%s ' "$role" >>"$FAKE_CALLS"
[[ -n $answer ]] || exit 1
printf '{"structured_output": %s}\n' "$answer"
EOF
chmod +x "$tmp/claude"

failures=0
fresh() {
  rm -rf "$tmp/config" "$tmp/state"
  mkdir -p "$tmp/config/slack/answer"
  echo "- my address" >"$tmp/config/slack/answer/private.md"
}
# run <event>: sets $out, $status, $calls and $outcome (the trace's last).
run() {
  : >"$tmp/calls"
  set +e
  out=$(ANSWER_CLAUDE=$tmp/claude FAKE_CALLS=$tmp/calls XDG_CONFIG_HOME=$tmp/config \
    XDG_STATE_HOME=$tmp/state "$here/answer" <<<"$1" 2>/dev/null)
  status=$?
  set -e
  calls=$(xargs <"$tmp/calls")
  outcome=$(tail -n 1 "$tmp/state/slack/answer.jsonl" 2>/dev/null | jq -r '.outcome + ": " + .why') || outcome=
}
# expect <case> <status> <stdout> <calls> <outcome>
expect() {
  if [[ $status != "$2" || $out != "$3" || $calls != "$4" || $outcome != "$5" ]]; then
    printf 'FAIL %s\n  got:  %s | %s | %s | %s\n  want: %s | %s | %s | %s\n' \
      "$1" "$status" "$out" "$calls" "$outcome" "$2" "$3" "$4" "$5"
    failures=$((failures + 1))
  else
    echo "ok   $1"
  fi
}

night=$(cat "$here/fixtures/night-question.json")
# The same sender in another conversation.
elsewhere=$(jq '.conversation.id = "C0OTHER" | .conversation.kind = "channel"' <<<"$night")
away='{"category":"away","why":"wants a review"}'
playful='{"category":"playful","why":"wants a recipe"}'
note='{"reply":"  Jane, Alex n'"'"'est pas disponible.  "}'
pass='{"verdict":"pass","reason":"fine"}'
export FAKE_JUDGE FAKE_RESPOND FAKE_REVIEW

fresh
FAKE_JUDGE=$away FAKE_RESPOND=$note FAKE_REVIEW=$pass
run "$night"
expect "a reply the reviewer passes is printed, trimmed" 0 "Jane, Alex n'est pas disponible." \
  "judge respond review" "answered: the reviewer passed it"
run "$night"
expect "one reply per conversation in 12 hours" 0 "" "" \
  "skipped: an automatic reply in this conversation in the last 12 hours"
run "$elsewhere"
expect "another conversation of the same sender is answered" 0 "Jane, Alex n'est pas disponible." \
  "judge respond review" "answered: the reviewer passed it"

fresh
FAKE_JUDGE=$playful
run "$night"
expect "a first playful reply" 0 "Jane, Alex n'est pas disponible." \
  "judge respond review" "answered: the reviewer passed it"
run "$elsewhere"
expect "one playful reply per sender in 7 days" 0 "" "judge" \
  "skipped: a playful reply to this sender in the last 7 days"
FAKE_JUDGE=$away
run "$(jq '.conversation.id = "C0THIRD"' <<<"$night")"
expect "a real question after the playful one is answered" 0 "Jane, Alex n'est pas disponible." \
  "judge respond review" "answered: the reviewer passed it"

fresh
printf '# colleagues\n@jane  # Jane\n' >"$tmp/config/slack/answer/skip"
run "$night"
expect "a handle on the skip list" 0 "" "" "skipped: on the skip list"

fresh
run "$(jq '.messages[-1].text = "Automatic reply: I am out of the office"' <<<"$night")"
expect "another automatic reply" 0 "" "" "skipped: another automatic reply"

fresh
FAKE_JUDGE='{"category":"skip","why":"a thank-you"}'
run "$night"
expect "the judge says skip" 0 "" "judge" "skipped: the judge"
FAKE_JUDGE=$away

for case in "Écris à @jane|it has an @, a mention or an email" \
  "Voir https://example.com|it has a link" \
  "Appelle le 06 12 34 56 78|it has a phone number" \
  "Réponse automatique : absent|it repeats the marker the watch adds"; do
  fresh
  FAKE_RESPOND=$(jq -nc --arg reply "${case%%|*}" '{reply: $reply}')
  run "$night"
  expect "a draft rejected without the reviewer: ${case#*|}" 0 "" "judge respond" "rejected: ${case#*|}"
done
FAKE_RESPOND=$note

fresh
FAKE_REVIEW='{"verdict":"reject","reason":"says why he is away"}'
run "$night"
expect "the reviewer rejects" 0 "" "judge respond review" "rejected: the reviewer"
FAKE_REVIEW=$pass

fresh
FAKE_JUDGE=
run "$night"
expect "a failed call exits non-zero and prints nothing" 1 "" "judge" ""
FAKE_JUDGE=$away

fresh
rm "$tmp/config/slack/answer/private.md"
run "$night"
expect "no private list, no run" 2 "" "" ""

if [[ $failures -gt 0 ]]; then
  echo "$failures failed"
  exit 1
fi
